@startuml
title Diagrama de Classes (visão de domínio) - Rede Raízes do Nordeste

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #FFF8E1
  BorderColor #1F3864
  ArrowColor #1F3864
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #A68B00
}

' ================= ENUMERAÇÕES =================
enum Perfil {
  CLIENTE
  ATENDENTE
  COZINHA
  GERENTE
  ADMIN
}
enum CanalPedido {
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB
}
enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}
enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
}
enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
  ESTORNO
}
enum TipoMovimentoPontos {
  ACUMULO
  RESGATE
  ESTORNO
}
enum TipoPromocao {
  PERCENTUAL
  VALOR_FIXO
}

' ================= ENTIDADES =================
class Unidade {
  - id : int
  - nome : String
  - cidade : String
  - uf : String
  - matriz : boolean
  - ativa : boolean
}

class Usuario {
  - id : int
  - nome : String
  - email : String {unique}
  - senhaHash : String
  - perfil : Perfil
  - ativo : boolean
  - criadoEm : DateTime
  - anonimizadoEm : DateTime
  + autenticar(senha) : boolean
  + anonimizar() : void
}

class Consentimento {
  - id : int
  - finalidade : String
  - baseLegal : String
  - versaoTermo : String
  - concedido : boolean
  - registradoEm : DateTime
  - revogadoEm : DateTime
  + estaAtivo() : boolean
  + revogar() : void
}

class Produto {
  - id : int
  - nome : String
  - descricao : String
  - categoria : String
  - precoBase : Decimal
  - ativo : boolean
}

class CardapioUnidade {
  - preco : Decimal
  - disponivel : boolean
}

class Estoque {
  - id : int
  - quantidade : int {>= 0}
  + baixar(qtd) : boolean
  + creditar(qtd) : void
}

class MovimentoEstoque {
  - id : int
  - tipo : TipoMovimentoEstoque
  - quantidade : int {> 0}
  - motivo : String
  - criadoEm : DateTime
}

class Promocao {
  - id : int
  - codigo : String {unique}
  - tipo : TipoPromocao
  - valor : Decimal
  - inicio : DateTime
  - fim : DateTime
  - ativa : boolean
  + estaVigente() : boolean
  + calcularDesconto(subtotal) : Decimal
}

class Pedido {
  - id : int
  - canalPedido : CanalPedido
  - status : StatusPedido
  - subtotal : Decimal
  - desconto : Decimal
  - total : Decimal
  - formaPagamento : String
  - idempotencyKey : String {unique}
  - criadoEm : DateTime
  + calcularTotal() : Decimal
  + podeTransitar(para, perfil) : boolean
  + cancelar() : void
}

class ItemPedido {
  - id : int
  - quantidade : int {> 0}
  - precoUnitario : Decimal
  + subtotal() : Decimal
}

class Pagamento {
  - id : int
  - status : StatusPagamento
  - valor : Decimal
  - metodo : String
  - referenciaExterna : String
  - payloadResposta : Json
  - idempotencyKey : String {unique}
  - criadoEm : DateTime
}

class MovimentoPontos {
  - id : int
  - tipo : TipoMovimentoPontos
  - pontos : int {> 0}
  - criadoEm : DateTime
}

class LogAuditoria {
  - id : int
  - acao : String
  - entidade : String
  - entidadeId : int
  - detalhes : Json
  - criadoEm : DateTime
}

' ================= INTEGRAÇÃO EXTERNA (desacoplada) =================
interface PagamentoGateway <<Domain>> {
  + cobrar(solicitacao) : RespostaGateway
}
class PagamentoMockGateway <<Infrastructure>> {
  + cobrar(solicitacao) : RespostaGateway
}
PagamentoGateway <|.. PagamentoMockGateway

' ================= RELACIONAMENTOS =================
Unidade "1" o-- "0..*" Usuario : equipe vinculada
Unidade "1" *-- "0..*" CardapioUnidade
Produto "1" *-- "0..*" CardapioUnidade
Unidade "1" *-- "0..*" Estoque : estoque próprio
Produto "1" *-- "0..*" Estoque
Estoque "1" *-- "0..*" MovimentoEstoque : histórico

Usuario "1" -- "0..*" Pedido : realiza
Unidade "1" -- "0..*" Pedido : recebe
Pedido "1" *-- "1..*" ItemPedido : contém
Produto "1" -- "0..*" ItemPedido : vendido em
Promocao "0..1" -- "0..*" Pedido : aplicada em

Pedido "1" *-- "0..*" Pagamento : tentativas
Pedido "1" -- "0..*" MovimentoEstoque : baixa / estorno
Pedido "1" -- "0..*" MovimentoPontos : origina

Usuario "1" *-- "0..*" Consentimento : concede
Usuario "1" *-- "0..*" MovimentoPontos : saldo = soma
Usuario "0..1" -- "0..*" LogAuditoria : gera

Usuario ..> Perfil
Pedido ..> CanalPedido
Pedido ..> StatusPedido
Pagamento ..> StatusPagamento
MovimentoEstoque ..> TipoMovimentoEstoque
MovimentoPontos ..> TipoMovimentoPontos
Promocao ..> TipoPromocao
Pagamento ..> PagamentoGateway : resposta do gateway

note right of Pedido
  **Regras de domínio**
  - canalPedido é obrigatório
  - preço do item é congelado no pedido (RN01)
  - só cria pedido se TODOS os itens têm estoque (RN02)
  - transições de status validadas por perfil (RN04)
end note

note bottom of MovimentoPontos
  Saldo de pontos = ACUMULO + ESTORNO - RESGATE.
  Só acumula/resgata com Consentimento ativo (RN08).
end note
@enduml
