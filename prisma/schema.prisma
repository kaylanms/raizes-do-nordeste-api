generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://raizes:RaizesDB2026Macae@127.0.0.1:5433/raizes_db?schema=public"
}

// ============ ENUMS ============

enum Perfil {
  CLIENTE
  ATENDENTE
  COZINHA
  GERENTE
  ADMIN

  @@map("perfil")
}

enum CanalPedido {
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB

  @@map("canal_pedido")
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO

  @@map("status_pedido")
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO

  @@map("status_pagamento")
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
  ESTORNO

  @@map("tipo_movimento_estoque")
}

enum TipoPromocao {
  PERCENTUAL
  VALOR_FIXO

  @@map("tipo_promocao")
}

enum TipoMovimentoPontos {
  ACUMULO
  RESGATE
  ESTORNO

  @@map("tipo_movimento_pontos")
}

enum FinalidadeConsentimento {
  FIDELIDADE

  @@map("finalidade_consentimento")
}

// ============ MODELOS ============

model Unidade {
  id     Int     @id @default(autoincrement())
  nome   String
  cidade String
  uf     String  @db.Char(2)
  matriz Boolean @default(false)
  ativa  Boolean @default(true)

  usuarios  Usuario[]
  cardapio  CardapioUnidade[]
  estoques  Estoque[]
  pedidos   Pedido[]

  @@map("unidades")
}

model Usuario {
  id             Int       @id @default(autoincrement())
  nome           String
  email          String    @unique
  senhaHash      String    @map("senha_hash")
  perfil         Perfil    @default(CLIENTE)
  unidadeId      Int?      @map("unidade_id")
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  anonimizadoEm  DateTime? @map("anonimizado_em")

  unidade            Unidade?            @relation(fields: [unidadeId], references: [id])
  pedidos            Pedido[]
  consentimentos     Consentimento[]
  movimentosPontos   MovimentoPontos[]
  movimentosEstoque  MovimentoEstoque[]
  logs               LogAuditoria[]

  @@map("usuarios")
}

model Consentimento {
  id           Int                     @id @default(autoincrement())
  usuarioId    Int                     @map("usuario_id")
  finalidade   FinalidadeConsentimento
  baseLegal    String                  @map("base_legal")
  versaoTermo  String                  @map("versao_termo")
  concedido    Boolean
  registradoEm DateTime                @default(now()) @map("registrado_em")
  revogadoEm   DateTime?               @map("revogado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, finalidade])
  @@map("consentimentos")
}

model Produto {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String?
  categoria String
  precoBase Decimal @map("preco_base") @db.Decimal(10, 2)
  ativo     Boolean @default(true)

  cardapio CardapioUnidade[]
  estoques Estoque[]
  itens    ItemPedido[]

  @@map("produtos")
}

model CardapioUnidade {
  unidadeId  Int     @map("unidade_id")
  produtoId  Int     @map("produto_id")
  preco      Decimal @db.Decimal(10, 2)
  disponivel Boolean @default(true)

  unidade Unidade @relation(fields: [unidadeId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([unidadeId, produtoId])
  @@map("cardapio_unidade")
}

model Estoque {
  id         Int @id @default(autoincrement())
  unidadeId  Int @map("unidade_id")
  produtoId  Int @map("produto_id")
  quantidade Int @default(0) // CHECK (quantidade >= 0) na migration

  unidade    Unidade            @relation(fields: [unidadeId], references: [id])
  produto    Produto            @relation(fields: [produtoId], references: [id])
  movimentos MovimentoEstoque[]

  @@unique([unidadeId, produtoId])
  @@map("estoque")
}

model MovimentoEstoque {
  id        Int                  @id @default(autoincrement())
  estoqueId Int                  @map("estoque_id")
  pedidoId  Int?                 @map("pedido_id")
  usuarioId Int                  @map("usuario_id")
  tipo      TipoMovimentoEstoque
  quantidade Int                 // CHECK (quantidade > 0) na migration
  motivo    String?
  criadoEm  DateTime             @default(now()) @map("criado_em")

  estoque Estoque @relation(fields: [estoqueId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([estoqueId])
  @@index([pedidoId])
  @@map("movimentos_estoque")
}

model Promocao {
  id        Int          @id @default(autoincrement())
  codigo    String       @unique
  descricao String
  tipo      TipoPromocao
  valor     Decimal      @db.Decimal(10, 2)
  inicio    DateTime
  fim       DateTime
  ativa     Boolean      @default(true)

  pedidos Pedido[]

  @@map("promocoes")
}

model Pedido {
  id              Int          @id @default(autoincrement())
  clienteId       Int          @map("cliente_id")
  unidadeId       Int          @map("unidade_id")
  canalPedido     CanalPedido  @map("canal_pedido")
  status          StatusPedido @default(AGUARDANDO_PAGAMENTO)
  subtotal        Decimal      @db.Decimal(10, 2)
  desconto        Decimal      @default(0) @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  promocaoId      Int?         @map("promocao_id")
  formaPagamento  String       @map("forma_pagamento")
  idempotencyKey  String?      @unique @map("idempotency_key")
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")

  cliente           Usuario            @relation(fields: [clienteId], references: [id])
  unidade           Unidade            @relation(fields: [unidadeId], references: [id])
  promocao          Promocao?          @relation(fields: [promocaoId], references: [id])
  itens             ItemPedido[]
  pagamentos        Pagamento[]
  movimentosEstoque MovimentoEstoque[]
  movimentosPontos  MovimentoPontos[]

  @@index([unidadeId, canalPedido, status])
  @@index([clienteId])
  @@map("pedidos")
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int     // CHECK (quantidade > 0) na migration
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
  @@map("itens_pedido")
}

model Pagamento {
  id                Int             @id @default(autoincrement())
  pedidoId          Int             @map("pedido_id")
  status            StatusPagamento @default(PENDENTE)
  valor             Decimal         @db.Decimal(10, 2)
  metodo            String
  referenciaExterna String?         @map("referencia_externa")
  payloadResposta   Json?           @map("payload_resposta")
  idempotencyKey    String?         @unique @map("idempotency_key")
  criadoEm          DateTime        @default(now()) @map("criado_em")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@map("pagamentos")
}

model MovimentoPontos {
  id        Int                 @id @default(autoincrement())
  usuarioId Int                 @map("usuario_id")
  pedidoId  Int?                @map("pedido_id")
  tipo      TipoMovimentoPontos
  pontos    Int                 // CHECK (pontos > 0) na migration
  criadoEm  DateTime            @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])

  @@index([usuarioId])
  @@map("movimentos_pontos")
}

model LogAuditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?     @map("usuario_id")
  acao       String
  entidade   String
  entidadeId Int?     @map("entidade_id")
  detalhes   Json?
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}